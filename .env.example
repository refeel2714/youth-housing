# DB (Supabase)
DATABASE_URL=            # Supavisor 세션 모드(5432)
DIRECT_URL=              # 마이그레이션·시드용 직접 연결

# API
APP_ORIGIN=http://localhost:5173
TOSS_APP_ORIGIN=
SESSION_SECRET=
ADMIN_EMAILS=
ADMIN_PASSWORD=           # 검수 화면(/admin) 비밀번호, 8자 이상. SESSION_SECRET(16자 이상)과 함께 있어야 켜짐
NOTIFY_INTERVAL_SEC=300
AUTO_PUBLISH=all          # all: 접수 일정 있는 미검수 공고도 공개(기본) / api: API 소스만 / off: 검수 완료만
PUBLIC_SHOW_UNVERIFIED=    # 1이면 반려 말고 전부 보임(로컬 확인용, 운영 금지)

# 카카오 로그인(웹)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# 토스 로그인·푸시(이름은 토스 콘솔 표기에 맞춰 조정)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_MTLS_CERT=
TOSS_MTLS_KEY=
TOSS_PUSH_TEMPLATE_ID=

# 메일
RESEND_API_KEY=
MAIL_FROM=

# 수집기
ANTHROPIC_API_KEY=
PARSE_MODEL=
LH_API_KEY=
COLLECT_SOURCES=LH_API,SEOUL_HOUSING
COLLECT_INTERVAL_MS=700  # 같은 사이트 요청 간 최소 간격
LH_LOOKBACK_DAYS=60      # LH 공고게시일 기준 며칠 전까지
SEOUL_LOOKBACK_DAYS=90   # 서울주거포털 공고게시일 기준 며칠 전까지
SEOUL_MAX_PAGES=20

# web 빌드
VITE_TARGET=web          # web | toss
VITE_API_BASE=           # 웹은 비움(같은 출처), 토스는 전체 주소
VITE_ROUTER_BASE=/
